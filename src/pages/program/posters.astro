---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
---

<PageLayout
  title="Posters"
  eyebrow="Program"
  lede="Two dedicated poster sessions give presenters time to discuss their work in depth."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Program', href: '/program' }, { label: 'Posters' }]}
>
  <Prose>
    <h2>Format</h2>
    <p>
      Posters must be <strong>A0 portrait</strong> (841 × 1189 mm, vertical orientation).
      Mounting pins are provided on-site — please do not use tape or adhesives on the boards.
    </p>
    <h2>Sessions</h2>
    <ul>
      <li><strong>Poster session A</strong> — Tuesday 16 June, 16:00, SLUB foyer.</li>
      <li><strong>Poster session B</strong> — Thursday 18 June, 16:00, SLUB foyer.</li>
    </ul>
    <p>
      You will be notified of your assigned session and board number with your acceptance.
      Please mount your poster before the morning coffee break on your session day and
      remove it by the end of that day.
    </p>
    <h2>On-site printing</h2>
    <p>
      If you would rather not travel with your poster, a partner shop near campus offers
      same-day A0 printing. See <a href="/practical">Practical Information</a> for details
      and opening hours.
    </p>
  </Prose>
</PageLayout>
