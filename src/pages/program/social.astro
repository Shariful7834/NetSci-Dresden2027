---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
---

<PageLayout
  title="Social Program"
  eyebrow="Program"
  lede="Time to meet, reconnect, and see the city — built into the schedule."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Program', href: '/program' }, { label: 'Social' }]}
>
  <Prose>
    <h2>Welcome reception</h2>
    <p>
      <strong>Monday 15 June, 18:00 — Zwinger Palace.</strong> An informal evening to open the
      conference, with drinks and the chance to meet fellow attendees in one of Dresden's most
      iconic baroque settings. Included with registration.
    </p>
    <h2>Excursion</h2>
    <p>
      <strong>Wednesday 17 June, afternoon — Saxon Switzerland.</strong> A guided trip to the
      dramatic sandstone landscapes of the Elbe Sandstone Mountains, a short ride from the city.
      Optional; sign up during registration (limited places).
    </p>
    <h2>Conference dinner</h2>
    <p>
      <strong>Thursday 18 June, 19:30 — Schloss Albrechtsberg.</strong> A seated dinner overlooking
      the Elbe valley, including the awards announcement. A dinner ticket can be added during
      registration.
    </p>
  </Prose>
</PageLayout>
