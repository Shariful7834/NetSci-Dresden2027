---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const speakers = (await getCollection('speakers')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<PageLayout
  title="Keynote Speakers"
  eyebrow="Program"
  lede="Invited keynotes spanning the breadth of network science — from epidemics to inference, dynamics, and learning on graphs."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Program', href: '/program' },
    { label: 'Speakers' },
  ]}
>
  <div class="grid sm:grid-cols-2 gap-6">
    {speakers.map((s) => (
      <article
        data-reveal
        class="bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 flex flex-col"
      >
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-full bg-tu-navy text-white font-display text-xl font-bold flex items-center justify-center shrink-0">
            {s.data.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}
          </div>
          <div>
            <h2 class="font-display text-xl font-bold text-tu-deep leading-tight">{s.data.name}</h2>
            <p class="text-sm text-tu-ink/70">{s.data.affiliation}</p>
          </div>
        </div>
        <div class="mt-4 text-xs uppercase tracking-[0.2em] text-tu-blue font-semibold">{s.data.field}</div>
        <p class="mt-1 font-medium text-tu-deep">“{s.data.talkTitle}”</p>
        <p class="mt-3 text-sm text-tu-ink/70 leading-relaxed" set:html={s.body} />
      </article>
    ))}
  </div>
</PageLayout>
