---
import PageLayout from '../../layouts/PageLayout.astro';
import { schedule } from '../../data/program';

const kindStyles: Record<string, string> = {
  keynote: 'bg-tu-gold/15 text-tu-deep border-tu-gold/40',
  session: 'bg-tu-ice text-tu-navy border-tu-navy/15',
  break: 'bg-tu-cream text-tu-ink/60 border-tu-navy/10',
  social: 'bg-tu-ember/10 text-tu-ember border-tu-ember/30',
  satellite: 'bg-tu-sky/15 text-tu-blue border-tu-sky/30',
};
---

<PageLayout
  title="Schedule"
  eyebrow="Program"
  lede="Five days of keynotes, contributed sessions, posters, and social program. Times are subject to change."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Program', href: '/program' },
    { label: 'Schedule' },
  ]}
>
  <div class="grid gap-8 lg:grid-cols-5">
    {schedule.map((d) => (
      <section data-reveal class="lg:col-span-1">
        <div class="sticky top-20">
          <h2 class="font-display text-xl font-bold text-tu-deep">{d.day}</h2>
          <p class="text-sm text-tu-ink/60 mb-4">{d.date}</p>
        </div>
        <ul class="space-y-3">
          {d.slots.map((slot) => (
            <li class:list={['rounded-xl border p-3', kindStyles[slot.kind]]}>
              <div class="text-xs font-mono opacity-70">{slot.time}{slot.room && ` · ${slot.room}`}</div>
              <div class="text-sm font-medium mt-0.5 leading-snug">{slot.title}</div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</PageLayout>
