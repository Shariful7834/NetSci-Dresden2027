---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
---

<PageLayout
  title="Getting to Dresden"
  eyebrow="Venue & Travel"
  lede="Dresden is well connected by air and rail across central Europe."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Venue & Travel', href: '/venue' }, { label: 'Travel' }]}
>
  <Prose>
    <h2>By air</h2>
    <ul>
      <li><strong>Dresden (DRS)</strong> — closest airport, ~20 min by S-Bahn or taxi to the centre.</li>
      <li><strong>Berlin (BER)</strong> — ~2h by direct train (ICE/EC).</li>
      <li><strong>Prague (PRG)</strong> — ~2h by bus or train, scenic Elbe valley route.</li>
      <li><strong>Leipzig/Halle (LEJ)</strong> — ~1h15 by train.</li>
    </ul>
    <h2>By rail</h2>
    <p>
      Dresden Hauptbahnhof is served by frequent long-distance trains. From the station, trams reach
      the campus and city centre in minutes. Deutsche Bahn offers discounted event tickets for many
      conferences — check closer to the date.
    </p>
    <h2>Getting around</h2>
    <p>
      Dresden's trams and buses (DVB) are punctual and inexpensive. Trams <strong>3, 8, and 11</strong>
      stop near the venue. A multi-day ticket covers the whole conference; consider the Dresden City
      Card for museums and transport combined.
    </p>
  </Prose>
</PageLayout>
