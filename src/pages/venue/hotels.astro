---
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/ui/Prose.tsx';
---

<PageLayout
  title="Hotels & Accommodation"
  eyebrow="Venue & Travel"
  lede="A range of stays within easy tram reach of campus and the old town."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Venue & Travel', href: '/venue' }, { label: 'Hotels' }]}
>
  <Prose>
    <p>
      Dresden offers accommodation at every budget. We recommend booking early — June is peak season.
      The Neustadt and Altstadt districts are both well connected to campus by tram.
    </p>
    <h2>Suggested areas</h2>
    <ul>
      <li><strong>Altstadt (old town)</strong> — near the Zwinger and Frauenkirche; central, mid-to-upper range.</li>
      <li><strong>Neustadt</strong> — lively, good-value hotels and guesthouses, strong tram links.</li>
      <li><strong>Near campus (Südvorstadt)</strong> — closest to the venue, quieter, fewer options.</li>
    </ul>
    <h2>Budget options</h2>
    <p>
      Several hostels and student-style accommodations are available for those on a tighter budget.
      A list of partner hotels with conference rates will be published ahead of registration.
    </p>
  </Prose>
</PageLayout>
