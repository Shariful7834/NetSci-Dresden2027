---
import PageLayout from '../../layouts/PageLayout.astro';

const cards = [
  { href: '/venue/travel', title: 'Getting to Dresden', desc: 'Flights, rail, and routes from nearby airports.' },
  { href: '/venue/campus', title: 'TU Dresden Campus', desc: 'Session buildings, the SLUB, and how to find your way.' },
  { href: '/venue/hotels', title: 'Hotels & Accommodation', desc: 'Recommended stays at a range of budgets.' },
];
---

<PageLayout
  title="Venue & Travel"
  eyebrow="Dresden, Germany"
  lede="TU Dresden sits a short tram ride from the historic centre, the Elbe river, and the museums of the Zwinger."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Venue & Travel' }]}
>
  <div class="grid sm:grid-cols-3 gap-6">
    {cards.map((c) => (
      <a href={c.href} data-reveal class="group bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 hover:shadow-soft hover:-translate-y-1 transition-all duration-300">
        <h2 class="font-display text-xl font-bold text-tu-deep group-hover:text-tu-navy">{c.title}</h2>
        <p class="mt-2 text-sm text-tu-ink/70">{c.desc}</p>
      </a>
    ))}
  </div>
</PageLayout>
