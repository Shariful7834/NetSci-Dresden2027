---
import PageLayout from '../layouts/PageLayout.astro';
import Prose from '../components/ui/Prose.tsx';
import { dates } from '../data/conference';
---

<PageLayout
  title="Calls"
  eyebrow="Submissions"
  lede="Calls for abstracts, satellites, and travel grants. Key deadlines are listed below."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Calls' }]}
>
  <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10">
    <Prose>
      <h2>Call for abstracts</h2>
      <p>
        We invite single-page abstracts on all topics in network science. Accepted abstracts are
        scheduled as contributed talks, lightning talks, or posters. Submissions are reviewed by the
        program committee for scientific quality and relevance.
      </p>
      <h2>Call for satellites</h2>
      <p>
        Satellite organisers may propose half- or full-day symposia on focused topics, held on the
        days framing the main conference. Proposals should outline the theme, format, and intended
        audience.
      </p>
      <h2>Travel grants</h2>
      <p>
        A limited number of travel grants support students and researchers from under-represented
        regions. Apply after your abstract is accepted; see the deadline opposite.
      </p>
    </Prose>

    <aside data-reveal class="bg-white rounded-2xl border border-tu-navy/10 shadow-card p-7 h-fit">
      <h2 class="font-display text-lg font-bold text-tu-deep">Key deadlines</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {dates.map((d) => (
          <li class="flex justify-between gap-3">
            <span class:list={[d.done ? 'line-through text-tu-ink/40' : 'text-tu-ink']}>{d.label}</span>
            <span class:list={['font-mono shrink-0', d.done ? 'line-through text-tu-ink/40' : 'text-tu-ink/70']}>{d.date}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</PageLayout>
